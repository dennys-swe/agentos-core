# ── Banco de dados ──
# String de conexão do MongoDB (Atlas ou local). Obrigatória.
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority

# ── Autenticação ──
# Chave de assinatura dos JWT. Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
# Se ausente, o app gera uma chave temporária e os tokens são invalidados a cada reinício.
JWT_SECRET_KEY=
JWT_EXPIRE_HOURS=8

# ── Motor de IA (OpenRouter) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── WhatsApp Cloud API (Meta) ──
# Usados como fallback quando a clínica não tem credenciais próprias no banco.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
# Token do handshake de verificação do webhook, definido no painel da Meta.
META_VERIFY_TOKEN=

# ── Transbordo humano ──
# Minutos de inatividade antes de devolver a sessão ao agente.
HUMAN_INACTIVITY_TIMEOUT_MINUTES=15
